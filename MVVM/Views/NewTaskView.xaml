<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TaskApp.MVVM.Views.NewTaskView"
             xmlns:converters="clr-namespace:TaskApp.Converters"
             BackgroundColor="White">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:ColorConverter x:Key="ColorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid Margin="20" RowDefinitions="Auto,Auto,*,Auto">

        <!-- Enter New Task Section -->
        <VerticalStackLayout Grid.Row="0" Spacing="8">
            <Label Text="Enter New Task:" 
                   FontSize="16" 
                   TextColor="#999999" />
            <Frame BorderColor="#E0E0E0" 
                   BackgroundColor="White"
                   CornerRadius="8"
                   Padding="0"
                   HasShadow="False">
                <Entry Placeholder="Enter task name"
                       Text="{Binding Task}"
                       FontSize="16"
                       TextColor="#333333"
                       PlaceholderColor="#CCCCCC"
                       BackgroundColor="Transparent" />
            </Frame>
        </VerticalStackLayout>

        <!-- Choose Category Section -->
        <Label Grid.Row="1" 
               Text="Choose Category" 
               FontSize="16" 
               TextColor="#999999"
               Margin="0,30,0,12" />

        <!-- Categories List -->
        <ScrollView Grid.Row="2">
            <VerticalStackLayout>
                <CollectionView ItemsSource="{Binding Categories}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="0,8">
                                <HorizontalStackLayout Spacing="16">
                                    <Ellipse Fill="{Binding Color, Converter={StaticResource ColorConverter}}"
                                            WidthRequest="32"
                                            HeightRequest="32"
                                            VerticalOptions="Center" />
                                    <RadioButton Content="{Binding CategoryName}"
                                                FontSize="18"
                                                TextColor="#333333"
                                                GroupName="Category"
                                                IsChecked="{Binding IsSelected}"
                                                VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Add New Category Button -->
                <Grid Padding="0,8">
                    <HorizontalStackLayout Spacing="16">
                        <Ellipse Fill="#E0E0E0"
                                WidthRequest="32"
                                HeightRequest="32"
                                VerticalOptions="Center" />
                        <Label Text="Add New Category"
                               FontSize="18"
                               TextColor="#999999"
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="AddCategoryClicked" />
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>
                </Grid>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Add Button -->
        <Button Grid.Row="3"
                Text="Add"
                FontSize="18"
                TextColor="White"
                BackgroundColor="#6B6B6B"
                CornerRadius="8"
                HeightRequest="50"
                WidthRequest="120"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,0,20"
                Clicked="AddTaskClicked" />
    </Grid>
</ContentPage>