<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             ios:Page.UseSafeArea="False"
             x:Class="TaskApp.MVVM.Views.MainView"
             xmlns:converters="clr-namespace:TaskApp.Converters"
             BackgroundColor="White"
             Shell.NavBarIsVisible="False"
             Padding="0">

    <ContentPage.Resources>
        <ResourceDictionary>

            <converters:ColorConverter x:Key="ColorConverter" />
            <converters:ProgressColorConverter x:Key="ProgressColorConverter" />

            <!-- Circular + Button -->
            <Style x:Key="CircularButton" TargetType="Button">
                <Setter Property="WidthRequest" Value="56" />
                <Setter Property="HeightRequest" Value="56" />
                <Setter Property="CornerRadius" Value="28" />
                <Setter Property="FontSize" Value="28" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BackgroundColor" Value="#6B6B6B" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="HorizontalOptions" Value="End" />
                <Setter Property="VerticalOptions" Value="End" />
                <Setter Property="Margin" Value="0,0,20,20" />
            </Style>

        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid Margin="20,50,20,0" 
          RowDefinitions="Auto,Auto,*">

        <!-- Categories Section -->
        <VerticalStackLayout Grid.Row="0" Spacing="12" Margin="0,0,0,0">
            <Label Text="Categories" 
                   FontSize="16" 
                   TextColor="#999999"
                   Margin="0,0,0,0"/>

            <ScrollView Orientation="Horizontal" 
                       HeightRequest="220"
                       HorizontalScrollBarVisibility="Never">
                <CollectionView ItemsSource="{Binding Categories}"
                               HeightRequest="220">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Horizontal" 
                                       Span="2"
                                       HorizontalItemSpacing="12"
                                       VerticalItemSpacing="12" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <!-- UPDATED: Added gestures for single tap, double tap, and long press -->
                            <Grid Padding="16" 
                                  BackgroundColor="{Binding Color, Converter={StaticResource ColorConverter}}"
                                  WidthRequest="160"
                                  HeightRequest="100"
                                  x:Name="CategoryGrid">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="Category_Tapped" />
                                    <TapGestureRecognizer NumberOfTapsRequired="2" Tapped="Category_DoubleTapped" />
                                </Grid.GestureRecognizers>

                                <!-- Invisible button overlay for long press detection -->
                                <Button BackgroundColor="Transparent"
                                        Pressed="Category_Pressed"
                                        Released="Category_Released"
                                        Clicked="Category_ClickedEmpty" />

                                <!-- Scale based on IsSelected -->
                                <Grid.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}"
                                               TargetType="Grid"
                                               Value="True">
                                        <Setter Property="Scale" Value="1.12" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected}"
                                               TargetType="Grid"
                                               Value="False">
                                        <Setter Property="Scale" Value="1.0" />
                                    </DataTrigger>
                                </Grid.Triggers>

                                <RoundRectangle CornerRadius="12" 
                                              Fill="{Binding Color, Converter={StaticResource ColorConverter}}" />
                                <VerticalStackLayout Spacing="8" VerticalOptions="Center">
                                    <Label Text="{Binding PendingTasks}" 
                                           FontSize="24"
                                           FontAttributes="Bold"
                                           TextColor="#333333" />
                                    <Label Text="{Binding CategoryName}" 
                                           FontSize="16"
                                           TextColor="#333333" />
                                    <BoxView HeightRequest="3" 
                                            WidthRequest="{Binding Percentage, Converter={StaticResource ColorConverter}}"
                                            HorizontalOptions="Start"
                                            Margin="0,0,0,0"
                                            Color="{Binding DarkerColor, Converter={StaticResource ColorConverter}}"
                                            IsVisible="{Binding Percentage, Converter={StaticResource ColorConverter}}" />
                                </VerticalStackLayout>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </ScrollView>
        </VerticalStackLayout>

        <!-- Pending Tasks Label -->
        <Label Grid.Row="1"
               Text="Pending Tasks" 
               FontSize="16" 
               TextColor="#999999"
               Margin="0,30,0,12" />

        <!-- FIXED: ScrollView wrapper for tasks with proper padding at bottom -->
        <ScrollView Grid.Row="2">
            <VerticalStackLayout Spacing="0" Padding="0,0,0,80">

                <!-- Pending Tasks Collection with SWIPE TO DELETE -->
                <CollectionView ItemsSource="{Binding PendingTasks}"
                               SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <!-- SwipeView for delete functionality -->
                            <SwipeView>
                                <!-- Right swipe actions (Delete) -->
                                <SwipeView.RightItems>
                                    <SwipeItems Mode="Execute">
                                        <SwipeItem Text="Delete"
                                                  BackgroundColor="#FF3B30"
                                                  IconImageSource="trash.png"
                                                  Invoked="Task_SwipeDelete" />
                                    </SwipeItems>
                                </SwipeView.RightItems>

                                <!-- Task Content -->
                                <Grid Padding="0,5" BackgroundColor="White">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer NumberOfTapsRequired="2" Tapped="Task_DoubleTapped" />
                                    </Grid.GestureRecognizers>

                                    <HorizontalStackLayout Spacing="12">
                                        <CheckBox IsChecked="{Binding Completed}"
                                                CheckedChanged="checkBox_CheckedChanged"
                                                VerticalOptions="Center"
                                                Color="{Binding TaskColor, Converter={StaticResource ColorConverter}}" />
                                        <Label Text="{Binding TaskName}" 
                                               FontSize="16"
                                               VerticalOptions="Center"
                                               HorizontalOptions="FillAndExpand"
                                               TextColor="#333333" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Completed Tasks Label -->
                <Label Text="Completed Tasks" 
                       FontSize="16" 
                       TextColor="#999999"
                       Margin="0,24,0,12"
                       IsVisible="{Binding HasCompletedTasks}" />

                <!-- Completed Tasks Collection with SWIPE TO DELETE -->
                <CollectionView ItemsSource="{Binding CompletedTasks}"
                               SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <!-- SwipeView for delete functionality -->
                            <SwipeView>
                                <!-- Right swipe actions (Delete) -->
                                <SwipeView.RightItems>
                                    <SwipeItems Mode="Execute">
                                        <SwipeItem Text="Delete"
                                                  BackgroundColor="#FF3B30"
                                                  IconImageSource="trash.png"
                                                  Invoked="Task_SwipeDelete" />
                                    </SwipeItems>
                                </SwipeView.RightItems>

                                <!-- Task Content -->
                                <Grid Padding="0,5" BackgroundColor="White">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer NumberOfTapsRequired="2" Tapped="Task_DoubleTapped" />
                                    </Grid.GestureRecognizers>

                                    <HorizontalStackLayout Spacing="12">
                                        <CheckBox IsChecked="{Binding Completed}"
                                                CheckedChanged="checkBox_CheckedChanged"
                                                VerticalOptions="Center"
                                                Color="{Binding TaskColor, Converter={StaticResource ColorConverter}}" />
                                        <Label Text="{Binding TaskName}" 
                                               FontSize="16"
                                               VerticalOptions="Center"
                                               HorizontalOptions="FillAndExpand"
                                               TextDecorations="Strikethrough"
                                               TextColor="#999999" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Add Button - in separate Grid to avoid blocking scrolling -->
        <Button Grid.Row="2"
                Clicked="Button_Clicked"
                Style="{StaticResource CircularButton}"
                Margin="0,0,10,50"
                InputTransparent="False"
                Text="+" />
    </Grid>
</ContentPage>
