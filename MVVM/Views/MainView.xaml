<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             ios:Page.UseSafeArea="False"
             x:Class="TaskApp.MVVM.Views.MainView"
             xmlns:converters="clr-namespace:TaskApp.Converters"
             BackgroundColor="White"
             Shell.NavBarIsVisible="False"
             Padding="0">

    <ContentPage.Resources>
        <ResourceDictionary>

            <converters:ColorConverter x:Key="ColorConverter" />
            <converters:ProgressColorConverter x:Key="ProgressColorConverter" />

            <!-- Circular + Button -->
            <Style x:Key="CircularButton" TargetType="Button">
                <Setter Property="WidthRequest" Value="56" />
                <Setter Property="HeightRequest" Value="56" />
                <Setter Property="CornerRadius" Value="28" />
                <Setter Property="FontSize" Value="28" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BackgroundColor" Value="#6B6B6B" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="HorizontalOptions" Value="End" />
                <Setter Property="VerticalOptions" Value="End" />
                <Setter Property="Margin" Value="0,0,20,20" />
            </Style>

        </ResourceDictionary>
    </ContentPage.Resources>

    <!-- FIXED: Removed all top margins and padding -->
    <Grid Margin="20,50,20,0" 
          RowDefinitions="Auto,Auto,*">

        <!-- Categories Section -->
        <VerticalStackLayout Grid.Row="0" Spacing="12" Margin="0,0,0,0">
            <Label Text="Categories" 
                   FontSize="16" 
                   TextColor="#999999"
                   Margin="0,0,0,0"/>

            <!-- FIXED: Horizontal scroll with 2x2 grid layout -->
            <ScrollView Orientation="Horizontal" 
                       HeightRequest="220"
                       HorizontalScrollBarVisibility="Never">
                <CollectionView ItemsSource="{Binding Categories}"
                               HeightRequest="220">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Horizontal" 
                                       Span="2"
                                       HorizontalItemSpacing="12"
                                       VerticalItemSpacing="12" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="16" 
                                  BackgroundColor="{Binding Color, Converter={StaticResource ColorConverter}}"
                                  WidthRequest="160"
                                  HeightRequest="100">
                                <RoundRectangle CornerRadius="12" 
                                              Fill="{Binding Color, Converter={StaticResource ColorConverter}}" />
                                <VerticalStackLayout Spacing="8" VerticalOptions="Center">
                                    <Label Text="{Binding PendingTasks}" 
                                           FontSize="24"
                                           FontAttributes="Bold"
                                           TextColor="#333333" />
                                    <Label Text="{Binding CategoryName}" 
                                           FontSize="16"
                                           TextColor="#333333" />
                                    <!-- FIXED: Progress bar now spans almost full width with margins -->
                                    <BoxView HeightRequest="3" 
                                            WidthRequest="{Binding Percentage, Converter={StaticResource ColorConverter}}"
                                            HorizontalOptions="Start"
                                            Margin="0,0,0,0"
                                            Color="{Binding DarkerColor, Converter={StaticResource ColorConverter}}"
                                            IsVisible="{Binding Percentage, Converter={StaticResource ColorConverter}}" />
                                </VerticalStackLayout>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </ScrollView>
        </VerticalStackLayout>

        <!-- Pending Tasks Section -->
        <VerticalStackLayout Grid.Row="1" Spacing="12" Margin="0,30,0,0">
            <Label Text="Pending Tasks" 
                   FontSize="16" 
                   TextColor="#999999" />
        </VerticalStackLayout>

        <!-- Tasks List -->
        <CollectionView Grid.Row="2" 
                       ItemsSource="{Binding Tasks}"
                       Margin="0,12,0,0"
                       ItemsUpdatingScrollMode="KeepLastItemInView">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="0,5">
                        <HorizontalStackLayout Spacing="12">
                            <CheckBox IsChecked="{Binding Completed}"
                                    CheckedChanged="checkBox_CheckedChanged"
                                    VerticalOptions="Center"
                                    Color="{Binding TaskColor, Converter={StaticResource ColorConverter}}" />
                            <Label Text="{Binding TaskName}" 
                                   FontSize="16"
                                   VerticalOptions="Center"
                                   TextDecorations="{Binding Completed, Converter={StaticResource ColorConverter}}">
                                <Label.Triggers>
                                    <DataTrigger Binding="{Binding Completed}"
                                               TargetType="Label"
                                               Value="True">
                                        <Setter Property="TextColor" Value="#999999" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Completed}"
                                               TargetType="Label"
                                               Value="False">
                                        <Setter Property="TextColor" Value="#333333" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </HorizontalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Add Button - MOVED LEFT -->
        <Button Grid.Row="2"
                Clicked="Button_Clicked"
                Style="{StaticResource CircularButton}"
                Margin="0,0,10,50"
                Text="+" />
    </Grid>
</ContentPage>