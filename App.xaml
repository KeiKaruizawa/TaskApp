<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:TaskApp"
             x:Class="TaskApp.App"
             UserAppTheme="Light">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Force light theme colors -->
            <Color x:Key="Primary">#6B6B6B</Color>
            <Color x:Key="Secondary">#999999</Color>
            <Color x:Key="Tertiary">#333333</Color>

            <!-- Custom styles for DisplayPrompt and DisplayAlert -->
            <Style TargetType="Page" ApplyToDerivedTypes="True">
                <Setter Property="BackgroundColor" Value="White" />
            </Style>

            <!-- Style for Entry in prompts -->
            <Style TargetType="Entry">
                <Setter Property="TextColor" Value="#333333" />
                <Setter Property="PlaceholderColor" Value="#999999" />
                <Setter Property="BackgroundColor" Value="White" />
            </Style>

            <!-- Style for Labels -->
            <Style TargetType="Label">
                <Setter Property="TextColor" Value="#333333" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>